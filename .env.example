# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-very-secure-random-key-64chars

# Database Configuration
# Local SQLite default (leave empty or use sqlite:///ecommerce.db)
DATABASE_URL=sqlite:///ecommerce.db
# PostgreSQL for production (e.g. on Render/Neon/Supabase):
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce_db

# Admin User Defaults (used by seed script or first-run initialization)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=admin123

# Google Maps Platform API Key (Optional: Leave empty for graceful fallback)
GOOGLE_MAPS_API_KEY=

# Optional business details printed on order invoices
STORE_NAME=ShopFlow
STORE_ADDRESS=
STORE_EMAIL=
STORE_PHONE=

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=